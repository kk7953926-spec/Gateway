rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /email_verifications/{verificationId} {
      allow read, write: if true;
    }

    match /upi_payments/{paymentId} {
      allow read, write: if true;
    }

    match /system_logs/{logId} {
      allow read, write: if true;
    }
  }
}
